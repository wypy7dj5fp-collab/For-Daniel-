
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f5eee2">
<title>Для Данила ♡</title>
<style>
:root {
  --cream: #f5eee2;
  --paper: #fffaf2;
  --brown: #39271e;
  --brown2: #594131;
  --gold: #b9975b;
  --gold-light: #e4d2ad;
  --muted: #8d7967;
  --line: #e5d9c6;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 76px; }
body {
  margin: 0;
  background: var(--cream);
  color: var(--brown);
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.8;
}
button, a { -webkit-tap-highlight-color: transparent; }
button { font: inherit; cursor: pointer; }
a { color: inherit; }
button:focus-visible, a:focus-visible, summary:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 4px;
}
::selection { background: var(--gold-light); color: var(--brown); }

/* Входной экран */
.intro {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  overflow: auto;
  padding: 24px;
  background:
    radial-gradient(ellipse at 50% 35%, #fffdf8, transparent 70%),
    var(--cream);
  text-align: center;
  transition: opacity .8s ease, visibility .8s ease;
}
.intro.hide {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.intro-inner { width: min(100%, 370px); }
.eyebrow {
  color: var(--gold);
  font: 10px/1.8 Arial, sans-serif;
  letter-spacing: 4px;
  text-transform: uppercase;
}
.intro h1 {
  margin: 18px 0 8px;
  font-size: clamp(32px, 8vw, 43px);
  line-height: 1.25;
  font-weight: normal;
}
.intro-copy { color: var(--muted); font-size: 14px; }
.envelope {
  position: relative;
  display: block;
  width: min(290px, 82vw);
  height: 184px;
  margin: 38px auto 24px;
  padding: 0;
  overflow: hidden;
  border: 1px solid var(--gold);
  background: #ddc59d;
  box-shadow: 0 20px 50px #47311d1b;
  perspective: 700px;
}
.env-letter {
  position: absolute;
  inset: 14px 22px;
  display: grid;
  place-items: center;
  background: var(--paper);
  color: var(--brown);
  font-size: 23px;
  transition: transform .7s ease;
}
.env-flap {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: #cdb185;
  clip-path: polygon(0 0, 100% 0, 50% 65%);
  transform-origin: top;
  transition: transform .7s ease;
}
.env-seal {
  position: absolute;
  z-index: 3;
  top: 52%;
  left: 50%;
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  transform: translate(-50%, -50%);
  border: 1px solid #f2dfb8;
  border-radius: 50%;
  background: #783d30;
  color: #f4dfb5;
  font-size: 25px;
  box-shadow: 0 4px 10px #39271e25;
  transition: opacity .3s, transform .3s;
}
.envelope:hover .env-seal { transform: translate(-50%, -50%) scale(1.06); }
.intro.opening .env-flap { transform: rotateX(180deg); }
.intro.opening .env-letter { transform: translateY(-48px); }
.intro.opening .env-seal { opacity: 0; }
.hint { color: var(--muted); font-size: 12px; }

/* Главный экран */
.hero {
  position: relative;
  display: flex;
  min-height: 83svh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 55px 22px;
  background:
    radial-gradient(ellipse at 50% 20%, #74543b 0%, transparent 65%),
    var(--brown);
  color: var(--cream);
  text-align: center;
}
.hero::before, .hero::after {
  position: absolute;
  width: 250px;
  height: 250px;
  border: 1px solid #c5a66a30;
  border-radius: 50%;
  content: "";
  pointer-events: none;
}
.hero::before { top: -145px; left: -110px; }
.hero::after { right: -140px; bottom: -165px; width: 330px; height: 330px; }
.hero-content { position: relative; z-index: 1; }
.hero h2 {
  margin: 24px 0 18px;
  color: var(--cream);
  font-size: clamp(42px, 10vw, 68px);
  font-weight: normal;
  line-height: 1.2;
}
.hero-subtitle {
  max-width: 350px;
  color: #e7dac7;
  font-size: 16px;
  font-style: italic;
}
.ornament { margin: 20px 0; color: var(--gold); font-size: 25px; }
.gold-button {
  display: inline-block;
  margin-top: 22px;
  padding: 12px 23px;
  border: 1px solid var(--gold);
  background: var(--gold);
  color: #2d2017;
  text-decoration: none;
  font-size: 13px;
  transition: background .25s, transform .25s;
}
.gold-button:hover { background: var(--gold-light); transform: translateY(-2px); }

/* Навигация */
nav {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4px;
  padding: 10px 8px;
  border-bottom: 1px solid #ffffff10;
  background: #2d2019;
}
nav a {
  padding: 8px 12px;
  color: #eadfce;
  font: 11px Arial, sans-serif;
  text-decoration: none;
}
nav a:hover { color: var(--gold-light); }

/* Содержимое */
main { width: min(100% - 32px, 740px); margin: auto; padding-bottom: 65px; }
section { padding-top: 62px; scroll-margin-top: 60px; }
.section-label {
  color: #9a7848;
  font: 10px Arial, sans-serif;
  letter-spacing: 3px;
  text-transform: uppercase;
}
h2.section-title {
  margin: 12px 0;
  color: var(--brown);
  font-size: clamp(28px, 6vw, 39px);
  font-weight: normal;
  line-height: 1.3;
}
.lead { color: var(--muted); font-size: 14px; }
.paper {
  position: relative;
  margin-top: 24px;
  padding: clamp(23px, 5vw, 42px);
  border: 1px solid #dfceb1;
  background:
    linear-gradient(135deg, #ffffff70, transparent 65%),
    var(--paper);
  box-shadow: 0 14px 40px #39271e0d;
}
.paper-ornament { margin-bottom: 17px; color: var(--gold); text-align: center; font-size: 21px; }
.letter-text { font-size: 15px; line-height: 2; white-space: pre-line; }
.signature {
  margin-top: 26px;
  padding-top: 19px;
  border-top: 1px solid var(--line);
  color: #8d734d;
  text-align: center;
  font-style: italic;
}

/* 25 причин */
.reasons {
  margin: 26px 0 0;
  padding: 0;
  list-style: none;
  counter-reset: reason;
}
.reasons li {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 9px;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
  counter-increment: reason;
  font-size: 15px;
}
.reasons li::before {
  color: #a0804d;
  content: counter(reason, decimal-leading-zero);
  font: 11px Arial, sans-serif;
  padding-top: 6px;
}

/* Интерактивные письма */
.letters-list { margin-top: 25px; border-top: 1px solid var(--line); }
.letter-item { border-bottom: 1px solid var(--line); }
.letter-toggle {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 13px;
  padding: 18px 2px;
  border: 0;
  background: transparent;
  color: var(--brown);
  text-align: left;
}
.letter-number { color: #a0804d; font: 11px Arial, sans-serif; }
.letter-title { flex: 1; font-size: 15px; line-height: 1.6; }
.plus { color: var(--gold); font-size: 23px; transition: transform .25s; }
.letter-item.open .plus { transform: rotate(45deg); }
.letter-content {
  display: none;
  margin: 0 0 17px 25px;
  padding: 20px;
  border-left: 2px solid var(--gold);
  background: var(--paper);
  font-size: 14px;
  line-height: 1.95;
  white-space: pre-line;
  animation: fadeIn .3s ease;
}
.letter-item.open .letter-content { display: block; }
.letter-item.open .letter-title { color: #9a7848; }
.progress-note { color: var(--muted); font-size: 12px; }

/* Финал */
.final-button {
  display: block;
  width: 100%;
  margin: 22px auto 0;
  padding: 14px 18px;
  border: 1px solid var(--gold);
  background: transparent;
  color: var(--brown);
  font-size: 14px;
}
.final-button:disabled { opacity: .55; cursor: not-allowed; }
.final-button:not(:disabled):hover { background: var(--gold-light); }
.final-overlay[hidden] { display: none; }
.final-overlay {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  overflow-y: auto;
  padding: 18px;
  background: #211711db;
  backdrop-filter: blur(5px);
  animation: fadeIn .3s ease;
}
.final-card {
  position: relative;
  width: min(100%, 520px);
  margin: auto;
  padding: clamp(27px, 6vw, 48px);
  border: 1px solid var(--gold);
  background: var(--paper);
  text-align: center;
  box-shadow: 0 20px 70px #0003;
}
.final-close {
  position: absolute;
  top: 8px;
  right: 15px;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 29px;
}
.final-card h2 { margin: 20px 0; font-size: clamp(28px, 7vw, 39px); font-weight: normal; line-height: 1.3; }
.final-message { font-size: 14px; line-height: 2; white-space: pre-line; }
.final-ornament { color: var(--gold); font-size: 23px; letter-spacing: 5px; }
.final-signature { margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--line); color: #967647; font-style: italic; }

/* Подвал */
footer {
  padding: 40px 20px;
  background: var(--brown);
  color: #eee2d0;
  text-align: center;
}
footer .heart { color: var(--gold); font-size: 27px; }
footer p { font-size: 13px; color: #d5c5ae; }
.backtop {
  display: inline-block;
  margin-top: 20px;
  padding: 9px 16px;
  border: 1px solid #b9975b88;
  background: transparent;
  color: var(--cream);
  text-decoration: none;
  font-size: 12px;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(7px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (max-width: 440px) {
  nav { gap: 0; padding: 8px 2px; }
  nav a { padding: 9px 8px; font-size: 10px; }
  .hero { min-height: 78svh; }
  .letter-content { margin-left: 8px; padding: 16px; }
  .letter-toggle { gap: 9px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
</style>
</head>
