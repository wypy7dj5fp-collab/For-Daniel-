    <div class="final-signature">С любовью и благодарностью Богу 🤍</div>
    <div class="final-ornament">♡ ♡ ♡</div>
  </section>
</div>

<script>
/* Открытие конверта */
const intro = document.getElementById('intro');
document.getElementById('openEnvelope').addEventListener('click', () => {
  intro.classList.add('opening');
  window.setTimeout(() => {
    intro.remove();
    document.getElementById('home').scrollIntoView({ behavior: 'smooth' });
  }, 850);
});

/* Письма раскрываются по нажатию */
const items = [...document.querySelectorAll('.letter-item')];
const opened = new Set();
const finalButton = document.getElementById('showFinal');
const progressNote = document.getElementById('progressNote');

items.forEach(item => {
  const button = item.querySelector('.letter-toggle');
  button.addEventListener('click', () => {
    const willOpen = !item.classList.contains('open');
    item.classList.toggle('open', willOpen);
    button.setAttribute('aria-expanded', String(willOpen));

    if (willOpen) opened.add(item);

    const count = opened.size;
    if (count === items.length) {
      progressNote.textContent = 'Ты прочитал все письма. Последний сюрприз ждёт тебя 🤍';
      finalButton.disabled = false;
      finalButton.textContent = 'Открыть последнее письмо ♡';
    } else {
      progressNote.textContent =
        'Открыто писем: ' + count + ' из ' + items.length +
        '. В конце тебя ждёт ещё одно послание ♡';
    }
  });
});

/* Финальное послание */
const overlay = document.getElementById('finalOverlay');
const closeButton = document.getElementById('closeFinal');

finalButton.addEventListener('click', () => {
  if (finalButton.disabled) return;
  overlay.hidden = false;
  document.body.style.overflow = 'hidden';
  closeButton.focus();
});

function closeFinal() {
  overlay.hidden = true;
  document.body.style.overflow = '';
  finalButton.focus();
}

closeButton.addEventListener('click', closeFinal);
overlay.addEventListener('click', event => {
  if (event.target === overlay) closeFinal();
});
document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && !overlay.hidden) closeFinal();
});
</script>
</body>
